        -760,
        0
      ],
      "webhookId": "battery-pack-fault-weekly-report"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst body = item.json?.body ?? item.json ?? {};\nlet metadata = body.metadata ?? item.json?.metadata ?? {};\n\nif (typeof metadata === 'string') {\n  try {\n    metadata = JSON.parse(metadata);\n  } catch (error) {\n    throw new Error('metadata JSON 파싱 실패: ' + error.message);\n  }\n}\n\nif (!metadata || typeof metadata !== 'object' || Array.isArray(metadata)) {\n  metadata = {};\n}\n\nconst binaryEntries = Object.entries(item.binary ?? {});\nconst binaryFile = item.binary?.fault_source_csv ?? binaryEntries[0]?.[1];\nif (!binaryFile) {\n  throw new Error('multipart/form-data에서 CSV 파일을 찾지 못했습니다. 필드명 fault_source_csv를 확인하세요.');\n}\n\nconst toFiniteNumber = (value, fallback = 0) => {\n  const normalized = String(value ?? '')\n    .replace(/[% ,]/g, '')\n    .trim();\n  const parsed = Number(normalized);\n  return Number.isFinite(parsed) ? parsed : fallback;\n};\n\nconst sourceFile = String(\n  metadata.trigger_source_file\n  ?? metadata.csv_filename\n  ?? binaryFile.fileName\n  ?? 'fault_source.csv'\n).trim();\n\nconst eventId = String(\n  metadata.trigger_event_id\n  ?? body.event_id\n  ?? item.json?.event_id\n  ?? metadata.csv_sha256\n  ?? (Date.now() + '_' + sourceFile)\n).trim();\nif (!eventId) {\n  throw new Error('event_id를 생성하지 못했습니다.');\n}\n\nconst receivedAt = String(metadata.webhook_sent_at ?? new Date().toISOString());\nconst mode = /dchg|방전/i.test(sourceFile)\n  ? '방전'\n  : /(^|[_-])chg|충전/i.test(sourceFile)\n    ? '충전'\n    : '미상';\n\nconst suspectSensors = Array.isArray(metadata.suspect_sensors)\n  ? metadata.suspect_sensors.join(', ')\n  : String(metadata.suspect_sensors ?? '');\nconst faultConfidence = toFiniteNumber(metadata.fault_confidence, 0);\nconst faultConfidencePercent = toFiniteNumber(\n  metadata.fault_confidence_percent,\n  faultConfidence * 100\n);\nconst safeName = (receivedAt.slice(0, 10) + '_' + eventId + '_' + sourceFile)\n  .replace(/[\\\\/:*?\"<>|]/g, '_');\n\nreturn [{\n  json: {\n    event_id: eventId,\n    received_at: receivedAt,\n    source_file: sourceFile,\n    serial_number: String(metadata.trigger_serial_number ?? ''),\n    mode,\n    fault_type: String(metadata.fault_type ?? '미분류 불량'),\n    fault_confidence: faultConfidence,\n    fault_confidence_percent: faultConfidencePercent,\n    risk_level: toFiniteNumber(metadata.risk_level, 0),\n    risk_label: String(metadata.risk_label ?? ''),\n    rpn: toFiniteNumber(metadata.rpn, 0),\n    suspect_sensors: suspectSensors,\n    recommended_action: String(metadata.recommended_action ?? ''),\n    csv_filename: sourceFile,\n    archive_filename: safeName,\n    csv_row_count: toFiniteNumber(metadata.csv_row_count ?? body.row_count, 0),\n    csv_size_bytes: toFiniteNumber(metadata.csv_size_bytes, 0),\n    csv_sha256: String(metadata.csv_sha256 ?? ''),\n    model_name: String(metadata.model_name ?? '배터리팩 LSTM 모델'),\n    model_version: String(metadata.model_version ?? ''),\n    action_status: String(metadata.action_status ?? '현장 검토 중'),\n    owner: String(metadata.owner ?? ''),\n    report_status: 'PENDING',\n    report_week: '',\n    raw_metadata_json: JSON.stringify(metadata),\n  },\n  binary: {\n    fault_source_csv: binaryFile,\n  },\n}];"
      },
