        "mode": "runOnceForAllItems",
        "jsCode": "const source = $('Webhook 파싱 및 검증').first().json;\nconst uploaded = $input.first().json ?? {};\nconst driveFileId = String(uploaded.id ?? uploaded.fileId ?? '');\n\nreturn [{\n  json: {\n    ...source,\n    drive_file_id: driveFileId,\n    drive_url: String(\n      uploaded.webViewLink\n      ?? uploaded.webContentLink\n      ?? (driveFileId ? 'https://drive.google.com/open?id=' + driveFileId : '')\n    ),\n  },\n}];"
